{
  "name": "docs-1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "技术面试备考文档引擎：声明式目录 + 元数据驱动，VitePress 渲染",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs --port 4173 --host 0.0.0.0",
    "check:content": "node --experimental-strip-types --no-warnings scripts/check-content.mjs",
    "check:zh": "node scripts/lint-zh.mjs --baseline $(cat scripts/ste-lint-zh.baseline 2>/dev/null || echo 0)",
    "new": "node scripts/new-content.mjs",
    "check:orchestration": "node scripts/check-orchestration.mjs",
    "export:skill": "node scripts/export-skill.mjs",
    "test:component": "python3 -m pytest tests/ -q",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:extensibility": "node --experimental-strip-types --no-warnings scripts/assert-extensibility.mjs",
    "selftest:gates": "node scripts/selftest-gates.mjs"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "vitepress": "1.6.4",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=22"
  }
}
