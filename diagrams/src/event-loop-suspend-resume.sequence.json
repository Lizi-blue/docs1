    },
    {
      "id": "t1",
      "type": "backend",
      "label": "任务 1",
      "sublabel": "等待 read"
    },
    {
      "id": "t2",
      "type": "backend",
      "label": "任务 2",
      "sublabel": "等待 write"
    },
    {
      "id": "io",
      "type": "messagebus",
      "label": "IO 多路复用",
