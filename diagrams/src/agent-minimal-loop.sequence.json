    },
    {
      "id": "dec",
      "type": "backend",
      "label": "决策器",
      "sublabel": "只出意图"
    },
    {
      "id": "tools",
      "type": "backend",
      "label": "工具表",
      "sublabel": "校验与动作"
    },
    {
