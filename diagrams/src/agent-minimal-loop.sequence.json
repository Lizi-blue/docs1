    {
      "id": "m4",
      "from": "dec",
      "to": "ctl",
      "y": 272,
      "label": "返回意图或答案",
      "variant": "return"
    },
    {
      "id": "m5",
      "from": "ctl",
      "to": "tools",
      "y": 306,
      "label": "execute(decision)",
      "variant": "emphasis"
    },
    {
      "id": "m6",
      "from": "tools",
      "to": "ctx",
      "y": 340,
      "label": "结果或可读错误",
      "variant": "return"
    },
    {
      "id": "m7",
      "from": "ctl",
      "to": "ctx",
      "y": 374,
      "label": "记录动作"
    },
    {
      "id": "m8",
      "from": "ctl",
      "to": "dec",
      "y": 408,
      "label": "下一轮或判终止"
