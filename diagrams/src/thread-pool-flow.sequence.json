    {
      "dot": "emerald",
      "title": "主路径",
      "items": [
        "主线程只负责投递与汇总",
        "worker 数量决定并发上限",
        "I/O 等待期间别的 worker 继续取任务"
      ]
    },
    {
      "dot": "orange",
      "title": "背压",
      "items": [
        "队列有上限时主线程会被阻塞",
        "队列无上限时内存会涨",
        "按内存与延迟目标设 maxsize"
      ]
    },
    {
      "dot": "rose",
      "title": "结束条件",
      "items": [
        "哨兵数量必须等于 worker 数量",
        "少投一个就有 worker 永久阻塞",
