  "cards": [
    {
      "dot": "orange",
      "title": "同一时刻只有一个线程跑字节码",
      "items": [
        "线程必须先拿到 GIL 才能执行 Python 代码",
        "CPU 密集任务因此无法真正并行",
        "换多进程才能用满多核"
      ]
    },
    {
      "dot": "emerald",
      "title": "I/O 等待时会主动让出",
      "items": [
        "阻塞式 I/O 前解释器释放 GIL",
        "别的线程立刻接上继续执行",
        "I/O 密集任务因此仍能重叠"
      ]
    },
    {
      "dot": "rose",
      "title": "切换有成本",
      "items": [
        "线程切换由时间片与解释器共同决定",
        "线程过多时切换开销超过收益",
        "并发数要按任务类型定"
      ]
    }
  ]
