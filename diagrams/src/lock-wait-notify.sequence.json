  "cards": [
    {
      "dot": "orange",
      "title": "为什么要 while 而不是 if",
      "items": [
        "被唤醒不等于条件成立",
        "其他线程可能先抢到锁并取走元素",
        "醒来后必须重新判断条件"
      ]
    },
    {
      "dot": "emerald",
      "title": "Condition 与 Semaphore 的分工",
      "items": [
        "Condition 表达状态变化与唤醒",
        "Semaphore 表达并发配额",
        "两者都要与业务状态分开看"
      ]
    },
    {
      "dot": "rose",
      "title": "常见错误",
      "items": [
        "在未持有锁时调用 wait()",
        "忘记 notify 导致消费者永久等待",
