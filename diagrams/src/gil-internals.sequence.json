  "cards": [
    {
      "dot": "orange",
      "title": "谁让出、什么时候让出",
      "items": [
        "计数到期：解释器主动请求让出",
        "阻塞式 I/O：调用前释放，返回后再抢",
        "长时间 C 扩展：不返回解释器就不让出"
      ]
    },
    {
      "dot": "emerald",
      "title": "为什么 CPU 密集任务不变快",
      "items": [
        "同一时刻只有一个线程执行字节码",
        "多线程只增加切换与竞争成本",
        "要并行只能换进程或原生扩展"
      ]
    },
    {
      "dot": "rose",
      "title": "工程结论",
      "items": [
        "I/O 密集：线程仍能重叠等待",
        "CPU 密集：先测再选进程池",
        "切换间隔可调，但不建议线上乱调"
      ]
    }
  ]
