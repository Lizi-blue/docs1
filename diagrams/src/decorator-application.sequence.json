      "variant": "return"
    },
    {
      "id": "m6",
      "from": "call",
      "to": "outer",
      "y": 370,
      "label": "调用最外层"
    },
    {
      "id": "m7",
      "from": "outer",
      "to": "inner",
      "y": 410,
      "label": "逐层向下"
    },
    {
      "id": "m8",
      "from": "inner",
      "to": "fn",
      "y": 450,
      "label": "最终调用原函数"
    },
    {
      "id": "m9",
      "from": "fn",
      "to": "call",
      "y": 490,
      "label": "返回值逐层回传",
      "variant": "return"
