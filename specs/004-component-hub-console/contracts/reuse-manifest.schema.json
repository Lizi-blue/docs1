{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs-1.local/contracts/reuse-manifest.schema.json",
  "title": "组件复用清单（reuse/<component>/manifest.json）",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "contract_version", "page", "sides"],
  "properties": {
    "component": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "contract_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "page": { "type": "string", "pattern": "^/" },
    "notes": { "type": "string" },
    "sides": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "backend": { "$ref": "#/$defs/side" },
        "frontend": { "$ref": "#/$defs/side" }
      }
    }
  },
  "$defs": {
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "external_deps", "adaptation", "verify"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "purpose", "required"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 4, "maxLength": 80 },
              "required": { "type": "boolean" }
            }
          }
        },
        "external_deps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "install"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "install": { "type": "string", "minLength": 1 }
            }
          }
        },
        "adaptation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point", "how"],
            "properties": {
              "point": { "type": "string", "minLength": 2, "maxLength": 40 },
              "how": { "type": "string", "minLength": 4, "maxLength": 120 }
            }
          }
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "expect"],
            "properties": {
              "command": { "type": "string", "minLength": 2 },
              "expect": { "type": "string", "minLength": 4, "maxLength": 120 }
            }
          }
        }
      }
    }
  }
}
