# 业务仓变量文件（本仓唯一能力开关）。
# 覆盖 ci 仓 _defaults.env 与 projects/<id>/project.env 的默认值。
# 优先级：_defaults.env < projects/<id>/project.env < 本文件 < workflow with:/env(INPUT_*)
#
# 本仓性质：**纯文档仓**（Markdown + YAML 元数据是唯一事实源）。
# 镜像 = VitePress 构建产物 + Caddy 托管；无后端、无数据库、无持久卷。
# 依赖安装与三条门禁都在 Dockerfile 阶段一完成，故本文件不设 INSTALL_CMD / TEST_CMD。

# ---- 项目身份 ----
PROJECT_NAME=docs-1
REPO_OWNER=dev
REPO_NAME=docs-1
IMAGE_NAME=dev/docs-1-docs

# ---- 构建 ----
DOCKERFILE_PATH=Dockerfile
CONTEXT_PATH=.
# k8s 清单**唯一生效目录**：ci deploy 阶段 render 后 apply 的目标。
MANIFEST_DIR=deploy
# runner 镜像只有 Python 3.13，没有 Node；前端门禁跑不在 runner 上。
# INSTALL_CMD=
# TEST_CMD=

# ---- 部署 ----
DEPLOY_TO_K8S=true
K8S_NAMESPACE=docs
DEPLOYMENT_NAME=docs-1-docs
INGRESS_HOST=docs1.minilab.uzibird.cn   # OpenWrt DNS 不支持连字符，host 不使用 -
CONTAINER_PORT=80
ROLLOUT_WAIT=true

# ---- 数据库 / 配置中心 / 权限上报：本仓都不需要 ----
DB_ENABLED=false
CONF_ENABLED=false
IAM_REPORT=false

# MUST NOT 写 IMAGE_TAG：镜像标签由 ci 按分支或 tag 派生。
# MUST NOT 把凭据写进本文件：走组织级 Secrets。
